# Copy to .env (never commit the real .env) and fill in real values before
# running: docker compose up --build

# --- Database ---
DB_NAME=billing_saas
DB_USERNAME=billing_app
DB_PASSWORD=change_me

# --- Backend ---
SPRING_PROFILES_ACTIVE=prod
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_base64_secret_min_256_bits
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
# The real domain(s) the frontend is served from - never "*" in production.
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# --- Frontend ---
FRONTEND_PORT=80

# --- Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME=Your Business Name
FRONTEND_BASE_URL=https://yourdomain.com
