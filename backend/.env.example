# Copy this file to .env (or export these as real environment variables) and fill in real values.
# NEVER commit a real .env file to source control.

SPRING_PROFILES_ACTIVE=dev

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/billing_saas
DB_USERNAME=billing_app
DB_PASSWORD=change_me
DB_POOL_SIZE=10

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_base64_secret_min_256_bits
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=billing-saas

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Server ---
SERVER_PORT=8080
APP_LOG_LEVEL=INFO
