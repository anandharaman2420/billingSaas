# Copy this file to .env (or export these as real environment variables) and fill in real values.
# NEVER commit a real .env file to source control.

SPRING_PROFILES_ACTIVE=dev

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/billing_saas
DB_USERNAME=billing_app
DB_PASSWORD=change_me
DB_POOL_SIZE=10

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_base64_secret_min_256_bits
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=billing-saas

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Server ---
SERVER_PORT=8080
APP_LOG_LEVEL=INFO

# --- Email (optional) ---
# EmailService logs and continues if these are left blank - the app runs
# fine in dev without a real SMTP provider. Set these to enable real
# password-reset, invoice, and payment-reminder emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME=Your Business Name
FRONTEND_BASE_URL=http://localhost:4200

# --- File uploads (optional) ---
# Local disk by default; see com.saasbilling.storage.FileStorageService.
UPLOAD_STORAGE_DIRECTORY=./uploads
UPLOAD_PUBLIC_BASE_URL=/api/files

# --- Razorpay (optional) ---
# Blank = plan changes stay MANUAL (no payment collected). Set these to
# enable real checkout + webhook-driven plan activation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Stripe (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Monthly subscription prices (INR) ---
PLAN_PRICE_FREE=0
PLAN_PRICE_BASIC=499
PLAN_PRICE_PROFESSIONAL=1499
PLAN_PRICE_BUSINESS=3999
PAYMENT_REMINDER_THROTTLE_DAYS=3
